{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear",
        "hooks": [
          {
            "type": "command",
            "command": "__GHOSTX_RUNTIME__/libexec/bind-codex-session",
            "timeout": 3,
            "statusMessage": "Binding this Codex session to its terminal"
          }
        ]
      }
    ]
  }
}

