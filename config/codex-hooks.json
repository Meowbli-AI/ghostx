{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear",
        "hooks": [
          {
            "type": "command",
            "command": "__GHOSTX_RUNTIME__/libexec/bind-codex-session",
            "timeout": 10,
            "statusMessage": "Binding this Codex session to its terminal"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "__GHOSTX_RUNTIME__/libexec/bind-codex-session",
            "timeout": 10,
            "statusMessage": "Saving this Codex session for Ghostty restoration"
          }
        ]
      }
    ]
  }
}
