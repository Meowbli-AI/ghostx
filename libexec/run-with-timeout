#!/usr/bin/perl

# Run one command with a wall-clock deadline while preserving stdin. Ghostx is
# macOS-only and uses the system Perl so completed hooks return immediately
# instead of waiting for a background shell timer to finish.

use strict;
use warnings;
use POSIX qw(WNOHANG);
use Time::HiRes qw(sleep time);

@ARGV >= 2 or exit 2;
my $timeout_seconds = shift @ARGV;
$timeout_seconds =~ /^[1-9][0-9]*$/ or exit 2;

my $command_pid = fork();
defined $command_pid or exit 2;

if ($command_pid == 0) {
    exec @ARGV;
    exit 127;
}

my $command_status;
my $deadline = time + $timeout_seconds;

while (1) {
    my $waited = waitpid($command_pid, WNOHANG);
    if ($waited == $command_pid) {
        $command_status = $?;
        last;
    }
    if ($waited == -1) {
        $command_status = -1;
        last;
    }
    last if time >= $deadline;
    sleep 0.02;
}

if (!defined $command_status) {
    kill 'TERM', $command_pid;
    sleep 0.1;
    kill 'KILL', $command_pid if kill 0, $command_pid;
    waitpid($command_pid, 0);
    exit 124;
}

exit 127 if $command_status == -1;
exit 128 + ($command_status & 127) if $command_status & 127;
exit $command_status >> 8;
