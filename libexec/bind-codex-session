#!/bin/sh

# Codex SessionStart hook: bind the exact session UUID to the Ghostty surface
# UUID exported by the interactive shell integration. Failures are deliberately
# non-fatal so terminal integration can never prevent Codex from starting.

set -u
umask 077

state_dir=${GHOSTX_STATE_DIR:-"${XDG_STATE_HOME:-$HOME/.local/state}/ghostx"}
state_file="$state_dir/state.json"

payload=$(cat) || exit 0
session_id=$(printf '%s' "$payload" | /usr/bin/plutil -extract session_id raw -o - - 2>/dev/null) || exit 0

case "$session_id" in
  ????????-????-????-????-????????????) ;;
  *) exit 0 ;;
esac

case ${TERM_PROGRAM:-} in
  ghostty|Ghostty) ;;
  *)
    [ -n "${GHOSTX_ALLOW_NON_GHOSTTY:-}" ] || exit 0
    ;;
esac

surface_id=${GHOSTX_SURFACE_ID:-}
case "$surface_id" in
  ????????-????-????-????-????????????) ;;
  *)
    # Existing sessions do not inherit shell integration retroactively. Once
    # one prompt has identified their surface, reuse that unambiguous mapping
    # instead of asking Ghostty through AppleScript on every later prompt.
    if [ -f "$state_file" ]; then
      existing_surface=""
      surface_ids=$(/usr/bin/plutil -extract surfaces raw -o - "$state_file" 2>/dev/null) || surface_ids=""
      for candidate_surface in $surface_ids; do
        candidate_session=$(
          /usr/bin/plutil -extract "surfaces.$candidate_surface.session_id" raw -o - "$state_file" 2>/dev/null
        ) || candidate_session=""
        if [ "$candidate_session" = "$session_id" ]; then
          if [ -n "$existing_surface" ]; then
            existing_surface=""
            break
          fi
          existing_surface=$candidate_surface
        fi
      done
      surface_id=$existing_surface
    fi
    ;;
esac
case "$surface_id" in
  ????????-????-????-????-????????????) ;;
  *)
    runtime_dir=$(CDPATH= cd -- "$(dirname -- "$0")/.." 2>/dev/null && pwd) || exit 0
    identify_surface="$runtime_dir/libexec/identify-ghostty-surface"
    if [ -x "$identify_surface" ]; then
      surface_id=$("$identify_surface" 2>/dev/null) || surface_id=""
    fi
    ;;
esac
case "$surface_id" in
  ????????-????-????-????-????????????) ;;
  *) exit 0 ;;
esac

mkdir -p "$state_dir" || exit 0
lock_dir="$state_dir/.bind-lock"
attempt=0
while ! mkdir "$lock_dir" 2>/dev/null; do
  attempt=$((attempt + 1))
  [ "$attempt" -lt 40 ] || exit 0
  sleep 0.05
done
cleanup_lock() {
  rmdir "$lock_dir" 2>/dev/null || true
}
trap cleanup_lock EXIT HUP INT TERM

tmp_file=$(mktemp "$state_dir/state.XXXXXX") || exit 0
cleanup_tmp() {
  rm -f "$tmp_file" 2>/dev/null || true
}

if [ -f "$state_file" ]; then
  /usr/bin/plutil -convert json -o - "$state_file" >/dev/null 2>&1 || {
    cleanup_tmp
    exit 0
  }
  cp "$state_file" "$tmp_file" || {
    cleanup_tmp
    exit 0
  }
else
  printf '%s\n' '{"version":1,"surfaces":{}}' >"$tmp_file" || exit 0
fi

record=$(printf '{"agent":"codex","session_id":"%s","updated_at":%s}' "$session_id" "$(date +%s)")
if /usr/bin/plutil -type "surfaces.$surface_id" "$tmp_file" >/dev/null 2>&1; then
  /usr/bin/plutil -replace "surfaces.$surface_id" -json "$record" "$tmp_file" >/dev/null 2>&1 || {
    cleanup_tmp
    exit 0
  }
else
  /usr/bin/plutil -insert "surfaces.$surface_id" -json "$record" "$tmp_file" >/dev/null 2>&1 || {
    cleanup_tmp
    exit 0
  }
fi

/usr/bin/plutil -convert json -r "$tmp_file" >/dev/null 2>&1 || {
  cleanup_tmp
  exit 0
}
mv "$tmp_file" "$state_file" || {
  cleanup_tmp
  exit 0
}
chmod 600 "$state_file" 2>/dev/null || true

exit 0
