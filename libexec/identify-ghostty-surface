#!/bin/sh

# Resolve the focused Ghostty terminal to its stable surface UUID. The caller's
# working directory must match so a hook from another app cannot bind to it.

set -u

runtime_dir=$(CDPATH= cd -- "$(dirname -- "$0")/.." 2>/dev/null && pwd) || exit 0
applescript_dir=${GHOSTX_APPLESCRIPT_DIR:-"$runtime_dir/applescript"}
osascript_bin=${GHOSTX_OSASCRIPT:-/usr/bin/osascript}
timeout_runner=${GHOSTX_TIMEOUT_RUNNER:-"$runtime_dir/libexec/run-with-timeout"}
lookup_timeout=${GHOSTX_LOOKUP_TIMEOUT:-1}
expected_directory=${1:-${GHOSTX_CWD:-${PWD:-}}}

case ${TERM_PROGRAM:-} in
  ghostty|Ghostty) ;;
  *) exit 0 ;;
esac

[ -n "$expected_directory" ] || exit 0
[ -d "$expected_directory" ] || exit 0
expected_directory=$(CDPATH= cd -- "$expected_directory" 2>/dev/null && pwd -P) || exit 0

[ -r "$applescript_dir/find-focused-terminal.applescript" ] || exit 0
[ -x "$timeout_runner" ] || exit 0

surface_id=$(
  "$timeout_runner" "$lookup_timeout" \
    "$osascript_bin" "$applescript_dir/find-focused-terminal.applescript" \
    "$expected_directory" 2>/dev/null
) || surface_id=""

case "$surface_id" in
  ????????-????-????-????-????????????) printf '%s\n' "$surface_id" ;;
esac

exit 0
