#!/bin/sh

# Bind Codex TUI processes that were already running before Ghostx hooks were
# installed. Session identity comes from the rollout file already opened by the
# process; terminal identity comes from the process TTY and Ghostty title lookup.

set -u

runtime_dir=$(CDPATH= cd -- "$(dirname -- "$0")/.." 2>/dev/null && pwd) || exit 0
pgrep_bin=${GHOSTX_PGREP:-/usr/bin/pgrep}
ps_bin=${GHOSTX_PS:-/bin/ps}
lsof_bin=${GHOSTX_LSOF:-/usr/sbin/lsof}
identify_surface=${GHOSTX_IDENTIFY_SURFACE:-"$runtime_dir/libexec/identify-ghostty-surface"}
bind_session=${GHOSTX_BIND_SESSION:-"$runtime_dir/libexec/bind-codex-session"}

[ -x "$pgrep_bin" ] || exit 0
[ -x "$ps_bin" ] || exit 0
[ -x "$lsof_bin" ] || exit 0
[ -x "$identify_surface" ] || exit 0
[ -x "$bind_session" ] || exit 0

codex_pids=$("$pgrep_bin" -x codex 2>/dev/null) || codex_pids=""
backfilled=0

for codex_pid in $codex_pids; do
  case "$codex_pid" in
    *[!0-9]* | "") continue ;;
  esac

  tty_name=$("$ps_bin" -o tty= -p "$codex_pid" 2>/dev/null | awk 'NF { print $1; exit }')
  case "$tty_name" in
    ttys[0-9]* | pts/[0-9]*) ;;
    *) continue ;;
  esac

  session_ids=$(
    "$lsof_bin" -Fn -p "$codex_pid" 2>/dev/null |
      sed -nE 's#^n.*-([[:xdigit:]]{8}-[[:xdigit:]]{4}-[[:xdigit:]]{4}-[[:xdigit:]]{4}-[[:xdigit:]]{12})\.jsonl$#\1#p' |
      sort -u
  )
  set -- $session_ids
  [ "$#" -eq 1 ] || continue
  session_id=$1

  tty_path="/dev/$tty_name"
  surface_id=$(
    TERM_PROGRAM=ghostty \
    GHOSTX_TTY="$tty_path" \
      "$identify_surface" 2>/dev/null
  ) || surface_id=""
  case "$surface_id" in
    ????????-????-????-????-????????????) ;;
    *) continue ;;
  esac

  printf '{"session_id":"%s","hook_event_name":"GhostxBackfill","cwd":""}\n' "$session_id" |
    TERM_PROGRAM=ghostty \
    GHOSTX_SURFACE_ID="$surface_id" \
      "$bind_session"
  backfilled=$((backfilled + 1))
done

printf '%s\n' "$backfilled"
exit 0
